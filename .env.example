# Enquiry persistence. When DATABASE_URL is empty, enquiries are stored in
# .data/enquiries.json so the site works locally without a database.
DATABASE_URL=
ENQUIRY_DATA_FILE=

# Admin access for /admin. ADMIN_TOKEN is required; treat it like a password.
ADMIN_TOKEN=
# Optional. When empty, the session key is derived from ADMIN_TOKEN.
ADMIN_SESSION_SECRET=
# Override only for local production-mode testing over plain HTTP.
ADMIN_COOKIE_SECURE=

# Optional outbound notification sent after every stored enquiry.
# The receiver must verify the X-MTT-Signature header (see README.md).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Optional public configuration.
# Canonical URLs and sitemap entries use this origin. Set it before deploying.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
